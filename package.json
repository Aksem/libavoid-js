{
  "name": "libavoid-js",
  "version": "0.5.0-beta.5",
  "description": "JS port of libavoid library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index-node.mjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "typings/"
  ],
  "scripts": {
    "build": "node build.js",
    "full-rebuild": "python tools/generate.py && npm run build",
    "api-docs": "typedoc",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "bench": "vitest bench --project 'node (bench)' --reporter verbose",
    "bench:browser": "vitest bench --project 'browser (bench)' --reporter verbose",
    "build:sanitizer": "python tools/generate.py --sanitizer",
    "leakcheck": "npm run build:sanitizer && node tools/leakcheck/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aksem/libavoid-js.git"
  },
  "author": "Vladyslav Hnatiuk",
  "license": "LGPL-2.1-or-later",
  "bugs": {
    "url": "https://github.com/Aksem/libavoid-js/issues"
  },
  "homepage": "https://github.com/Aksem/libavoid-js",
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "playwright": "^1.65.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
